# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=emergency_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d

# Twilio (legacy — unused)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# RapidAPI SMS Verify
RAPIDAPI_SMS_KEY=your_rapidapi_key_here
RAPIDAPI_SMS_HOST=sms-verify3.p.rapidapi.com
RAPIDAPI_SMS_URL=https://sms-verify3.p.rapidapi.com/send-numeric-verify

# Google Maps
GOOGLE_MAPS_KEY=

# CORS
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002