# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=emergency_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d

# ── Fast2SMS (OTP + emergency alerts) ────────────────────────────────────────
# API key: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_URL=https://www.fast2sms.com/dev/bulkV2

# "false" = quick/sandbox mode (plain text, no DLT needed for testing)
# "true"  = DLT production mode (requires approved templates below)
FAST2SMS_USE_DLT=false

# Your DLT-approved Sender ID — add it in fast2sms.com/dashboard/dlt-manager
FAST2SMS_SENDER_ID=FSTSMS

# ── DLT Template IDs (required only when FAST2SMS_USE_DLT=true) ──────────────
# Register these templates on Fast2SMS DLT Manager and paste the integer Message_ID here.
#
# Emergency template:
#   "ALERT: {#var#} ne SOS bheja hai. Ambulance dispatch ho gayi. Hospital: {#var#}. Case #{#var#}. Please call karo."
FAST2SMS_EMERGENCY_TEMPLATE_ID=

# OTP template:
#   "Your OTP is {#var#}. Do not share it. Valid for 5 minutes. - RescueNow"
FAST2SMS_OTP_TEMPLATE_ID=

# Google Maps
GOOGLE_MAPS_KEY=

# CORS
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002