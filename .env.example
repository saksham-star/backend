# Server
PORT=3000

# MySQL (mysql2 pool)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=emergency_db
DB_CONNECTION_LIMIT=10

# JWT (use a long random string in production)
JWT_SECRET=change-me-in-production-use-long-random-secret

# Twilio SMS (optional — if missing, SMS are logged to console only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
